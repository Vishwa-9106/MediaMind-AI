# Ensure consistent line endings in repo (LF)
* text=auto eol=lf

# Common text files use LF in repo
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.env text eol=lf

# Windows-specific scripts keep CRLF in working tree
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.zip binary
*.jar binary
